# LINE Messaging API設定
# 取得手順: https://developers.line.biz/ → チャンネル作成 → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 橋本香織さんのLINE User ID
# 取得方法: ボットを友達追加後、メッセージを送ってもらうとWebhookで確認できます
LINE_TARGET_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# バイナリ/Base64で画像を受け取る場合に必要（外部からアクセス可能なURL）
# URLで受け取る場合は不要
PUBLIC_BASE_URL=https://your-server.example.com

# サーバーポート（デフォルト: 5000）
FLASK_PORT=5000
