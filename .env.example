# ============================================================
# LINE Messaging API設定
# 取得手順:
#   1. https://developers.line.biz/ にアクセスしてログイン
#   2. 「新規チャンネル作成」→「Messaging API」を選択
#   3. チャンネル設定の「Messaging API」タブから以下を取得
# ============================================================

LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# 橋本香織さんのLINE User ID
# 取得方法:
#   1. 橋本香織さんにボットを友達追加してもらう
#   2. ボットに何かメッセージを送ってもらう
#   3. サーバーログまたはLINEの返信メッセージでUser IDが確認できる
LINE_TARGET_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# このサーバーの公開URL（バイナリ/Base64画像受信時に必要）
# AIBOがphoto_urlで送る場合は不要
PUBLIC_BASE_URL=https://your-domain.com

# サーバーポート（デフォルト: 5000）
FLASK_PORT=5000
